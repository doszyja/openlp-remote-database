# Rebuild static assets, then layer onto existing nginx image (avoids pulling nginx when registry DNS fails)
FROM node:22-alpine AS build

WORKDIR /app

RUN npm install -g pnpm

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY tsconfig.json ./tsconfig.json
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

RUN pnpm install --no-frozen-lockfile

COPY apps/web ./apps/web
COPY packages ./packages

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN pnpm --filter @openlp/shared build
RUN pnpm add -D -w vite @vitejs/plugin-react || true
RUN pnpm --filter web build

FROM openlp-database-web:latest AS production

COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/web/nginx-https.conf /etc/nginx/conf.d/nginx-https.conf
COPY apps/web/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80 443
CMD ["/docker-entrypoint.sh"]